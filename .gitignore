# ---- 数据（与代码分离，见 docs/DATASETS.md）----
# 关键: 必须写 "/data"（带前导斜杠），不能用 "data" 或 "data/"
#   "data"   会匹配任意层级名为 data 的目录，连 src/data/ 和 scripts/data/ 都被忽略
#   "data/"  只匹配目录，不匹配软链接（软链接会被当成文件提交）
#   "/data"  只匹配项目根目录，且同时匹配目录和软链接  ← 正确
/data

# 保留数据结构模板
!data.sample/
!data.sample/**

# ---- 临时/草稿（不入库）----
.scratch/

# ---- 训练产物 ----
# 策略：**按文件类型白名单**，而不是逐个目录列举。
# 理由：每次出新实验都要改白名单（本文件曾漏掉 .corr/.pred 目录和 6 个微波日志，
#       导致报告引用的证据不在仓库里）。按类型判断则新增实验目录自动覆盖。
#
# 保留：json/csv/yaml（指标与配置）、png（图）、log（训练记录）、md（索引）
# 排除：pt/ckpt（权重）、npz（逐样本预测，约 4 MB/个，可重跑生成）
outputs/*
!outputs/INDEX.md
!outputs/**/
!outputs/**/*.json
!outputs/**/*.csv
!outputs/**/*.yaml
!outputs/**/*.png
!outputs/**/*.log
!outputs/**/*.md

# 权重与逐样本预测体积大且可重跑生成，即使类型白名单也要排除。
# 顺序很重要：这两条必须放在上面的白名单**之后**，否则会被 !*.json 之类的规则推翻。
*.pt
*.ckpt
*.npz

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
*~
