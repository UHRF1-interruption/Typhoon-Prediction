# ---- 数据（与代码分离，见 docs/DATASETS.md）----
# 关键: 必须写 "/data"（带前导斜杠），不能用 "data" 或 "data/"
#   "data"   会匹配任意层级名为 data 的目录，连 src/data/ 和 scripts/data/ 都被忽略
#   "data/"  只匹配目录，不匹配软链接（软链接会被当成文件提交）
#   "/data"  只匹配项目根目录，且同时匹配目录和软链接  ← 正确
/data

# 保留数据结构模板
!data.sample/
!data.sample/**

# ---- 临时/草稿（不入库）----
.scratch/

# ---- 训练产物 ----
# 忽略 outputs 下全部内容，但保留被 README / 技术报告引用的图表与指标。
# 注意: 必须先忽略 outputs/* 再白名单子目录，直接写 !outputs/xxx/*.png 无效
#       （父目录被排除时 git 不会进入其中查找）
outputs/*
# 索引：说明每个目录是什么、对应报告哪一节
!outputs/INDEX.md
# 路径：业务基线与四模型汇总（报告 §3 的图表来源）
!outputs/baselines/
!outputs/comparison/
# 路径：环境场消融（报告 §3.3 的核心正面结论，−10.1 km）
!outputs/parallel/
!outputs/v1_2020_ablation/
!outputs/v2_ablation/
!outputs/v3_ablation/
!outputs/ablation_runs/
!outputs/env_ablation/
# 路径：分段策略与纬度自适应（报告 §3.4/§3.6）
!outputs/latitude_adaptive/
!outputs/segment_compare/
!outputs/segment_approaches/
!outputs/stratified_ablation/
# 强度：卫星云图结论（报告 §4.1）+ 地形/暖心消融（§4.3/§4.4）
# sat_intensity_history/ = 历史归档（混装 32px 与 64px 各轮）
# sat_intensity_64px/    = 当前默认配置的输出目录（见 satellite.run_name）
!outputs/sat_intensity_history/
!outputs/sat_intensity_64px/
!outputs/intensity_rerun_base/
!outputs/intensity_rerun_terrain/
!outputs/intensity_rerun_warmcore/
!outputs/intensity_rerun_summary.json
# RI 事件（报告 §4.2）
!outputs/ri_events/
# 数据构建日志：卫星数据规模演进（报告 §2.4）
!outputs/build_logs/
# 模型权重与逐样本预测数组体积大且可重跑生成，即使目录被白名单也要排除
*.pt
*.ckpt
outputs/**/*.npz

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
*~
